# --- Database (Supabase free-tier Postgres) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Not in the original Section 9 list — added for CNIC/marksheet Storage (6.1
# step 10). Optional; defaults to "tutor-documents" if unset.
SUPABASE_STORAGE_BUCKET=tutor-documents

# --- WhatsApp (Meta Cloud API, official/direct) — left in place, now dormant
# since the 2026-10 chat-export pivot (CLAUDE.md); kept in case live Meta
# setup is ever finished later. ---
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- LLM (Groq primary, Gemini fallback) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Payments (JazzCash) ---
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# --- Facebook Page (daily opportunities digest, 6.5) ---
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# --- Resend (neglected-parent email alerts, not in the original Section 9 list) ---
# Deliberately an email, not WhatsApp, to keep this off the WhatsApp cost
# budget (Section 1). Without a verified domain in Resend, their sandbox
# sender below can only deliver to the Resend account's own signup email —
# set OPERATOR_EMAIL to that address for testing; verify a real domain later.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
OPERATOR_EMAIL=

# --- Business config ---
COMMISSION_PERCENT=50
PREMIUM_NOTIFICATION_DELAY_MINUTES=60
RATING_REQUEST_DELAY_DAYS=30
ADMIN_WHATSAPP_NUMBER=

# --- Multi-user accounts (2026-10 planning session) ---
# ADMIN_DASHBOARD_PASSWORD is retired — replaced by real per-user accounts
# (the User table, managed from /users). SESSION_SECRET signs login cookies and
# must be set to something random in production (dev falls back to an
# insecure default if unset). INITIAL_ADMIN_EMAIL/PASSWORD create exactly one
# admin account the first time the User table is empty, then become inert —
# needed so retiring the shared password can't lock everyone out.
SESSION_SECRET=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=


# --- Vercel Cron (optional but recommended in production) ---
# Vercel automatically sends this as a Bearer token on its own cron-triggered
# requests once set as a project env var — guards the digest/publish routes
# from arbitrary public POSTs. Routes stay open (no auth check) until this is set.
CRON_SECRET=

# Homepage Google rating (Places API (New)) — 2026-10-15
GOOGLE_PLACES_API_KEY=
