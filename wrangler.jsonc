{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 2026-10-12 deviation (CLAUDE.md Section 4): deploy target moved from
  // Vercel to Cloudflare Workers — this file replaces vercel.json. See the
  // plan notes near lib/db.ts and worker.ts for why each piece is here.
  "name": "tutor-parent-matching",
  "main": "worker.ts",
  // Not a secret — just an identifier (from `wrangler whoami`). Added because
  // the scoped CI API token lacks account-listing permission, so Wrangler's
  // auto-detection fails ("Failed to automatically retrieve account IDs").
  // Verified live: the CLOUDFLARE_ACCOUNT_ID env var alone did NOT fix this
  // for `opennextjs-cloudflare deploy`'s internal account-resolution call —
  // it has to be here in the config file itself, exactly as Wrangler's own
  // error message suggests as the alternative.
  "account_id": "f0a99462abbc2d4caa90b7c2d936ee93",
  "compatibility_date": "2026-10-12",
  // nodejs_compat: required for Prisma's driver adapter (@prisma/adapter-pg)
  // and the existing node:crypto scrypt usage in lib/auth/passwords.ts.
  // global_fetch_strictly_public: from @opennextjs/cloudflare's own template —
  // a safe default restricting the Worker's fetch() to public addresses, fine
  // for this app since every outbound call (WhatsApp/Groq/Gemini/Supabase/
  // Facebook/Resend) is a public HTTPS API.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Bridges the Worker to the real Supabase Postgres instance over TCP —
  // Workers can't open raw TCP connections on their own. Created 2026-10-12
  // via `npx wrangler hyperdrive create academy-db --connection-string=...`
  // against the real Supabase project (flqguuitpmlprfadhlnr).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "55e9e7f55d7e4911902d698fbd0d8641"
    }
  ],
  // The Facebook Page post (every 3 hours since 2026-10-15 — was once daily),
  // and the shared 15-minute check used by both the notification-delay and
  // neglected-parent routes (see worker.ts's scheduled handler).
  "triggers": {
    "crons": ["0 */3 * * *", "*/15 * * * *"]
  }
}
